<Window x:Class="WpfClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Currency Exchange Office" Height="650" Width="950"
        Background="#F0F2F5">
    <Window.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2C3E50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,5,10,5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1A252F"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GreenButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#27AE60"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E8449"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RedButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#E74C3C"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C0392B"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,3,0,8"/>
        </Style>
        <Style x:Key="ModernLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#7F8C8D"/>
            <Setter Property="Margin" Value="0,5,0,2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2C3E50">
            <TextBlock Text="💱 Currency Exchange Office" 
                       Foreground="White" FontSize="20" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="20,0"/>
        </Border>

        <TabControl Grid.Row="1" Background="#F0F2F5" BorderThickness="0" Margin="10">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="15,8"/>
                </Style>
            </TabControl.Resources>

            <TabItem Header="📈 Rates">
                <Border Background="White" Margin="5" Padding="20" CornerRadius="5">
                    <StackPanel>
                        <TextBlock Text="Exchange Rates" FontSize="18" FontWeight="Bold" 
                                   Foreground="#2C3E50" Margin="0,0,0,15"/>
                        <TextBlock Text="Currency Code:" Style="{StaticResource ModernLabel}"/>
                        <TextBox x:Name="txtCurrency" Width="200" HorizontalAlignment="Left" 
                                 Style="{StaticResource ModernTextBox}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Get Rate" Style="{StaticResource ModernButton}" Click="GetRate_Click"/>
                            <Button Content="Get All Rates" Style="{StaticResource ModernButton}" Click="GetAllRates_Click"/>
                        </StackPanel>
                        <TextBox x:Name="txtRateResult" Height="350" IsReadOnly="True" 
                                 VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"
                                 FontFamily="Consolas" FontSize="12" Background="#F8F9FA"
                                 BorderBrush="#DEE2E6"/>
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem Header="👤 Account">
                <Border Background="White" Margin="5" Padding="20" CornerRadius="5">
                    <StackPanel>
                        <TextBlock Text="Account Management" FontSize="18" FontWeight="Bold" 
                                   Foreground="#2C3E50" Margin="0,0,0,15"/>
                        <TextBlock Text="Username:" Style="{StaticResource ModernLabel}"/>
                        <TextBox x:Name="txtUsername" Width="250" HorizontalAlignment="Left" 
                                 Style="{StaticResource ModernTextBox}"/>
                        <TextBlock Text="Password:" Style="{StaticResource ModernLabel}"/>
                        <PasswordBox x:Name="txtPassword" Width="250" HorizontalAlignment="Left" 
                                     FontSize="13" Padding="8,6" Margin="0,3,0,8"
                                     BorderBrush="#BDC3C7" BorderThickness="1"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Register" Style="{StaticResource GreenButton}" Click="Register_Click"/>
                            <Button Content="Login" Style="{StaticResource ModernButton}" Click="Login_Click"/>
                        </StackPanel>
                        <TextBlock Text="Top Up Amount (PLN):" Style="{StaticResource ModernLabel}" Margin="0,15,0,2"/>
                        <TextBox x:Name="txtTopUp" Width="250" HorizontalAlignment="Left" 
                                 Style="{StaticResource ModernTextBox}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Top Up" Style="{StaticResource GreenButton}" Click="TopUp_Click"/>
                            <Button Content="Get Balance" Style="{StaticResource ModernButton}" Click="GetBalance_Click"/>
                        </StackPanel>
                        <TextBox x:Name="txtAccountResult" Height="150" IsReadOnly="True" 
                                 VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"
                                 FontFamily="Consolas" FontSize="12" Background="#F8F9FA"
                                 BorderBrush="#DEE2E6"/>
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem Header="💰 Exchange">
                <Border Background="White" Margin="5" Padding="20" CornerRadius="5">
                    <StackPanel>
                        <TextBlock Text="Currency Exchange" FontSize="18" FontWeight="Bold" 
                                   Foreground="#2C3E50" Margin="0,0,0,15"/>
                        <TextBlock Text="Currency Code:" Style="{StaticResource ModernLabel}"/>
                        <TextBox x:Name="txtExCurrency" Width="250" HorizontalAlignment="Left" 
                                 Style="{StaticResource ModernTextBox}"/>
                        <TextBlock Text="Amount:" Style="{StaticResource ModernLabel}"/>
                        <TextBox x:Name="txtExAmount" Width="250" HorizontalAlignment="Left" 
                                 Style="{StaticResource ModernTextBox}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Buy Currency" Style="{StaticResource GreenButton}" Click="Buy_Click"/>
                            <Button Content="Sell Currency" Style="{StaticResource RedButton}" Click="Sell_Click"/>
                        </StackPanel>
                        <TextBox x:Name="txtExResult" Height="200" IsReadOnly="True" 
                                 VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"
                                 FontFamily="Consolas" FontSize="12" Background="#F8F9FA"
                                 BorderBrush="#DEE2E6"/>
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem Header="📋 History">
                <Border Background="White" Margin="5" Padding="20" CornerRadius="5">
                    <StackPanel>
                        <TextBlock Text="History" FontSize="18" FontWeight="Bold" 
                                   Foreground="#2C3E50" Margin="0,0,0,15"/>
                        <Button Content="Get My Transactions" Style="{StaticResource ModernButton}" 
                                Width="200" HorizontalAlignment="Left" Click="GetHistory_Click"/>
                        <TextBlock Text="Historical Exchange Rates" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#2C3E50" Margin="0,15,0,5"/>
                        <TextBlock Text="Currency Code:" Style="{StaticResource ModernLabel}"/>
                        <TextBox x:Name="txtHistCurrency" Width="250" HorizontalAlignment="Left" 
                                 Style="{StaticResource ModernTextBox}"/>
                        <TextBlock Text="Start Date (yyyy-MM-dd):" Style="{StaticResource ModernLabel}"/>
                        <TextBox x:Name="txtStartDate" Width="250" HorizontalAlignment="Left" 
                                 Style="{StaticResource ModernTextBox}"/>
                        <TextBlock Text="End Date (yyyy-MM-dd):" Style="{StaticResource ModernLabel}"/>
                        <TextBox x:Name="txtEndDate" Width="250" HorizontalAlignment="Left" 
                                 Style="{StaticResource ModernTextBox}"/>
                        <Button Content="Get Historical Rates" Style="{StaticResource ModernButton}" 
                                Width="200" HorizontalAlignment="Left" Click="GetHistoricalRates_Click"/>
                        <TextBox x:Name="txtHistResult" Height="200" IsReadOnly="True" 
                                 VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"
                                 FontFamily="Consolas" FontSize="12" Background="#F8F9FA"
                                 BorderBrush="#DEE2E6"/>
                    </StackPanel>
                </Border>
            </TabItem>

        </TabControl>
    </Grid>
</Window>